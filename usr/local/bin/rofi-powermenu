#!/bin/sh
# Power menu for i3.

theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/main_without_icons.rasi"

get_options() {
    printf '%s\n' "Poweroff" "Reboot" "Hibernate" "Lock" "Suspend" "Log out"
}

choice=$(get_options | rofi -dmenu -i -fuzzy -p "Power" -theme "$theme")

case "$choice" in
    "Poweroff")  systemctl poweroff ;;
    "Reboot")    systemctl reboot ;;
    "Hibernate") systemctl hibernate ;;
    "Lock")      exec "$HOME/.local/bin/lock" ;;
    "Suspend")   systemctl suspend ;;
    "Log out")   i3-msg exit ;;
esac
