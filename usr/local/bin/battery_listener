#!/bin/sh
# Low-battery notification daemon.

icons="${XDG_DATA_HOME:-$HOME/.local/share}/keyitdev/icons"
warning_level=20
check_interval=60

# Avoid duplicate listeners.
for pid in $(pidof -x battery_listener 2>/dev/null); do
    [ "$pid" = "$$" ] || kill "$pid" 2>/dev/null || true
done

while true; do
    battery_path=$(upower -e 2>/dev/null | grep BAT | head -n1)
    if [ -n "$battery_path" ]; then
        battery_level=$(upower -i "$battery_path" 2>/dev/null | grep -E "percentage" | sed 's/[^0-9]//g')
        discharging=$(upower -i "$battery_path" 2>/dev/null | grep -E "state" | grep -c "discharging")
        time_to_empty=$(upower -i "$battery_path" 2>/dev/null | grep -E "time to empty" | sed 's/.*: *//')

        if [ -n "$battery_level" ] && [ "$battery_level" -lt "$warning_level" ] && [ "$discharging" -eq 1 ]; then
            dunstify -a "Battery" \
                "Low battery: ${battery_level}%" \
                "Battery is low (${time_to_empty:-unknown} left)" \
                -r 100 \
                -i "$icons/battery.svg"
        fi
    fi

    sleep "${check_interval}s"
done
