#!/bin/sh
# Simple screenshot helper.
#   screenshot -sa  selected area
#   screenshot -sf  full screen

dir="${SCREENSHOT_DIR:-$HOME/Pictures/screenshots}"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$1" in
    -sa) maim -s "$file" ;;
    -sf) maim "$file" ;;
    *) echo "Usage: $0 -sa|-sf" >&2; exit 1 ;;
esac

# maim exits 0 even when the selection is cancelled; only notify if a file exists.
if [ -f "$file" ]; then
    xclip -selection clipboard -t image/png -i "$file"
    notify-send -i "$file" "Screenshot" "Saved to $file"
fi
