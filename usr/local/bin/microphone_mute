#!/bin/sh
# Show whether the default source is muted.

icons="${XDG_DATA_HOME:-$HOME/.local/share}/keyitdev/icons"
mute=$(pactl get-source-mute @DEFAULT_SOURCE@ | sed -n 's/^Mute: //p')

if [ "$mute" = "yes" ]; then
    dunstify -a "Microphone" "Microphone" "Microphone is muted" -r 100 -i "$icons/mic-off.svg"
else
    dunstify -a "Microphone" "Microphone" "Microphone is unmuted" -r 100 -i "$icons/mic.svg"
fi
