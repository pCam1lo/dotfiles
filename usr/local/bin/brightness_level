#!/bin/sh
# Show the current brightness using brightnessctl.

icons="${XDG_DATA_HOME:-$HOME/.local/share}/keyitdev/icons"

current="$(brightnessctl get 2>/dev/null || echo 0)"
maximum="$(brightnessctl max 2>/dev/null || echo 1)"
[ "$maximum" -gt 0 ] || maximum=1
percent=$(( current * 100 / maximum ))

if [ "$percent" -ge 50 ]; then
    dunstify "Screen" "Brightness: ${percent}%" -r 100 -i "$icons/sun.svg"
else
    dunstify "Screen" "Brightness: ${percent}%" -r 100 -i "$icons/moon.svg"
fi
