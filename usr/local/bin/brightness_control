#!/bin/sh
# Change screen brightness with brightnessctl (no root required).
# Usage: brightness_control -s +2   (increase 2%)
#        brightness_control -s -2   (decrease 2%)
#        brightness_control -s 50   (set 50%)

step="+2"

while getopts "s:" opt; do
    case "$opt" in
        s) step="$OPTARG" ;;
        *) echo "Usage: $0 -s +N|-N|N" >&2; exit 1 ;;
    esac
done

case "$step" in
    +*) brightnessctl set "${step#+}%+" ;;
    -*) brightnessctl set "${step#-}%-" ;;
    *)  brightnessctl set "${step}%" ;;
esac
