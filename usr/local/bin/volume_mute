#!/bin/sh
# Show whether the default sink is muted.

icons="${XDG_DATA_HOME:-$HOME/.local/share}/keyitdev/icons"
vol_quiet=33
vol_loud=66
vol_very_loud=101

cur_vol_left=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]\+%' | sed -n '1p' | sed 's/%//g')
cur_vol_right=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]\+%' | sed -n '2p' | sed 's/%//g')
[ -n "$cur_vol_left" ] || cur_vol_left=0
[ -n "$cur_vol_right" ] || cur_vol_right="$cur_vol_left"
cur_vol_average=$(( (cur_vol_left + cur_vol_right) / 2 ))
mute=$(pactl get-sink-mute @DEFAULT_SINK@ | sed -n 's/^Mute: //p')

if [ "$mute" = "yes" ]; then
    dunstify "Speakers" "Speakers are muted" -r 100 -i "$icons/volume-x.svg"
else
    if [ "$cur_vol_average" -le "$vol_quiet" ]; then
        icon="$icons/volume.svg"
    elif [ "$cur_vol_average" -le "$vol_loud" ]; then
        icon="$icons/volume-1.svg"
    elif [ "$cur_vol_average" -le "$vol_very_loud" ]; then
        icon="$icons/volume-2.svg"
    else
        icon="$icons/volume-3.svg"
    fi
    dunstify "Speakers" "Speakers are unmuted" -r 100 -i "$icon"
fi
