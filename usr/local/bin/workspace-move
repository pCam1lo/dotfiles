#!/bin/sh
# Move the focused window to a workspace and enforce odd/even output placement.

number="${1:?usage: workspace-move NUMBER}"
internal="${INTERNAL:-LVDS1}"
external=""

for output in DP1 HDMI1 VGA1; do
    if xrandr --query 2>/dev/null | grep -q "^${output} connected"; then
        external="$output"
        break
    fi
done

if [ "$number" -eq 1 ] 2>/dev/null; then
    target="$internal"
elif [ $((number % 2)) -eq 1 ]; then
    target="$internal"
else
    target="${external:-$internal}"
fi

current="$(i3-msg -t get_workspaces 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null || true)"

if [ "$current" = "$number" ]; then
    i3-msg "move workspace to output $target" >/dev/null 2>&1 || true
    exit 0
fi

i3-msg "move container to workspace number $number" >/dev/null 2>&1 || exit 1
i3-msg "workspace number $number" >/dev/null 2>&1 || exit 1
i3-msg "move workspace to output $target" >/dev/null 2>&1 || true

if [ -n "$current" ]; then
    i3-msg "workspace number $current" >/dev/null 2>&1 || true
fi
