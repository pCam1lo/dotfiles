#!/bin/sh
# Rofi menu for the simple screenshot helper.

theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/main_without_icons.rasi"

choice=$(printf '%s\n' "Selected area screenshot" "Full screen screenshot" | \
    rofi -dmenu -i -p "Screenshot" -theme "$theme")

case "$choice" in
    "Selected area screenshot") exec "$HOME/.local/bin/screenshot" -sa ;;
    "Full screen screenshot")   exec "$HOME/.local/bin/screenshot" -sf ;;
esac
