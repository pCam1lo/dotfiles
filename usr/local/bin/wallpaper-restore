#!/bin/sh
# Restore the wallpaper saved by rofi-wallpaper, or use the default.
# xwallpaper applies one image per output using the real monitor geometry.

set -eu

state="${XDG_CONFIG_HOME:-$HOME/.config}/i3/wallpaper"
default="$HOME/Pictures/wallpapers/background.png"
wallpaper="${WALLPAPER:-}"

if [ -z "$wallpaper" ] && [ -f "$state" ]; then
    wallpaper="$(cat "$state")"
fi

if [ -z "$wallpaper" ] || [ ! -f "$wallpaper" ]; then
    wallpaper="$default"
fi

[ -f "$wallpaper" ] || exit 0

outputs="$(xrandr --query 2>/dev/null | awk '/ connected/ { print $1 }')"

if command -v xwallpaper >/dev/null 2>&1 && [ -n "$outputs" ]; then
    set --
    for output in $outputs; do
        set -- "$@" --output "$output" --zoom "$wallpaper"
    done
    if xwallpaper "$@"; then
        exit 0
    fi
fi

# Fallback for systems without xwallpaper.
monitor_count="$(xrandr --listmonitors 2>/dev/null | awk 'NR > 1 { count++ } END { print count + 0 }')"
[ "$monitor_count" -ge 1 ] || monitor_count=1

set --
i=0
while [ "$i" -lt "$monitor_count" ]; do
    set -- "$@" "$wallpaper"
    i=$((i + 1))
done

feh --no-fehbg --bg-fill "$@"
